{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CUDA: 编译并调试当前项目",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "nvcc build current"
        },
        {
            "name": "CUDA: 调试 Day01 Hello CUDA",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/day01.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "nvcc build day01"
        },
        {
            "name": "CUDA: 调试 Day05 设备查询",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/day05.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "nvcc build day05"
        },
        {
            "name": "CUDA: 一键编译全部并调试",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/_build/day01.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "nvcc build all"
        },
        {
            "name": "Python: 运行当前 Python 文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "env": {"PYTHONIOENCODING": "utf-8"}
        }
    ]
